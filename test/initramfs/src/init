#!/bin/sh

# SPDX-License-Identifier: MPL-2.0

# The initramfs entry point (i.e., the init process).
#
# This sets up the basic environment and
# transfers control by executing the command-line arguments of the script,
# which typically either provide a shell for user interaction or
# run tests automatically.
#
# TODO: This script simulates the process of mounting filesystems
# as performed by a generic init process.
# It should later be replaced by the actual init process.

DM_ROOT_DEVICE=
DM_ROOT_REQUESTED=0
DM_ROOT_BOOTSTRAPPED=0
CRYPTSETUP_SMOKE_DEVICE=
CRYPTSETUP_SMOKE_REQUESTED=0
CRYPT_CORRECTNESS_DEVICE=
CRYPT_CORRECTNESS_REQUESTED=0
VERITY_PROBE_DEVICE=
VERITY_PROBE_BLOCK=
VERITY_PROBE_REQUESTED=0
DM_BENCH_RAW=
DM_BENCH_MAPPER=
DM_BENCH_REQUESTED=0
DM_BENCH_RW=read
DM_BENCH_BS=4k
DM_BENCH_QD=1
DM_BENCH_IOENGINE=sync
DM_BENCH_JOBS=1
DM_BENCH_SIZE=8m
DM_BENCH_RUNTIME=2
DM_BENCH_RUNS=5
DM_BENCH_RAMP=1
for arg in "$@"; do
    if [ "$arg" = "verity-probe" ]; then
        VERITY_PROBE_REQUESTED=1
        break
    fi
done
if [ "$VERITY_PROBE_REQUESTED" -eq 1 ]; then
    while [ "$#" -gt 0 ] && [ "$1" != "verity-probe" ]; do shift; done
    VERITY_PROBE_DEVICE="${2:-}"
    VERITY_PROBE_BLOCK="${3:-0}"
    shift 3
fi
for arg in "$@"; do
    if [ "$arg" = "crypt-correctness" ]; then
        CRYPT_CORRECTNESS_REQUESTED=1
        break
    fi
done
if [ "$CRYPT_CORRECTNESS_REQUESTED" -eq 1 ]; then
    while [ "$#" -gt 0 ] && [ "$1" != "crypt-correctness" ]; do
        shift
    done
    CRYPT_CORRECTNESS_DEVICE="${2:-}"
    shift 2
fi
for arg in "$@"; do
    if [ "$arg" = "dm-bench" ]; then
        DM_BENCH_REQUESTED=1
        break
    fi
done
if [ "$DM_BENCH_REQUESTED" -eq 1 ]; then
    while [ "$#" -gt 0 ] && [ "$1" != "dm-bench" ]; do
        shift
    done
    DM_BENCH_RAW="${2:-}"
    DM_BENCH_MAPPER="${3:-}"
    DM_BENCH_RW="${4:-read}"
    DM_BENCH_BS="${5:-4k}"
    DM_BENCH_QD="${6:-1}"
    DM_BENCH_SIZE="${7:-8m}"
    DM_BENCH_RUNTIME="${8:-2}"
    DM_BENCH_RUNS="${9:-5}"
    DM_BENCH_RAMP="${10:-1}"
    DM_BENCH_IOENGINE="${11:-sync}"
    DM_BENCH_JOBS="${12:-1}"
        # Keep the historical argument layout compatible: the extended
        # benchmark fields are read above, while only the three mode fields
        # need to be removed before the payload command is inspected.
        shift 3
fi
for arg in "$@"; do
    if [ "$arg" = "cryptsetup-smoke" ]; then
        CRYPTSETUP_SMOKE_REQUESTED=1
        break
    fi
done
if [ "$CRYPTSETUP_SMOKE_REQUESTED" -eq 1 ]; then
    while [ "$#" -gt 0 ] && [ "$1" != "cryptsetup-smoke" ]; do
        shift
    done
    CRYPTSETUP_SMOKE_DEVICE="${2:-}"
    shift 2
fi
for arg in "$@"; do
    if [ "$arg" = "dm-root" ] || [ "$arg" = "dm-root-stage2" ]; then
        DM_ROOT_REQUESTED=1
        break
    fi
done
if [ "$DM_ROOT_REQUESTED" -eq 1 ]; then
    while [ "$#" -gt 0 ] && [ "$1" != "dm-root" ] && [ "$1" != "dm-root-stage2" ]; do
        shift
    done
    if [ "$1" = "dm-root-stage2" ]; then
        DM_ROOT_BOOTSTRAPPED=1
    fi
    DM_ROOT_DEVICE="${2:-}"
    shift 2
fi

if [ "$#" -eq 0 ]; then
    echo "No arguments were provided to the init process. Spawn a shell by default."
    echo "Usage: $0 <prog> [args...]"
    set -- /bin/sh
fi

echo "[init] mounting sysfs"
mount -t sysfs none /sys
echo "[init] mounting proc"
mount -t proc none /proc
echo "[init] mounting cgroup2"
mount -t cgroup2 none /sys/fs/cgroup
echo "[init] mounting configfs"
mount -t configfs none /sys/kernel/config
echo "[init] mounting ext2"
mount -t ext2 /dev/vda /ext2
echo "[init] mounting exfat"
mount -t exfat /dev/vdb /exfat
echo "[init] mounts complete"

if [ -n "$DM_BENCH_RAW" ] && [ -n "$DM_BENCH_MAPPER" ]; then
    if [ ! -x /benchmark/bin/fio ]; then
        echo "[dm-bench] FAIL fio is missing from the benchmark initramfs"
        poweroff -f
    fi
    case "$DM_BENCH_MAPPER" in
        *crypt*) DM_BENCH_LABEL=dm-crypt ;;
        *verity*) DM_BENCH_LABEL=dm-verity ;;
        *)        DM_BENCH_LABEL=mapper ;;
    esac
    case "$DM_BENCH_RW" in
        read|randread) ;;
        write|randwrite)
            if [ "$DM_BENCH_LABEL" = "dm-verity" ]; then
                echo "[dm-bench] FAIL dm-verity is read-only"
                poweroff -f
            fi
            ;;
        *)
            echo "[dm-bench] FAIL unsupported rw=$DM_BENCH_RW"
            poweroff -f
            ;;
    esac
    echo "[dm-bench] fio=$(/benchmark/bin/fio --version)"
    echo "[dm-bench] matrix=raw,$DM_BENCH_LABEL runs=$DM_BENCH_RUNS rw=$DM_BENCH_RW bs=$DM_BENCH_BS ioengine=$DM_BENCH_IOENGINE qd=$DM_BENCH_QD jobs=$DM_BENCH_JOBS size=$DM_BENCH_SIZE runtime=${DM_BENCH_RUNTIME}s ramp=${DM_BENCH_RAMP}s"
    RUN=1
    while [ "$RUN" -le "$DM_BENCH_RUNS" ]; do
        if [ $((RUN % 2)) -eq 1 ]; then
            set -- raw "$DM_BENCH_LABEL"
        else
            set -- "$DM_BENCH_LABEL" raw
        fi
        for LABEL in "$@"; do
            if [ "$LABEL" = "raw" ]; then
                DEVICE="$DM_BENCH_RAW"
            else
                DEVICE="$DM_BENCH_MAPPER"
            fi
            echo "[dm-bench] BEGIN label=$LABEL run=$RUN device=$DEVICE operation=$DM_BENCH_RW block_size=$DM_BENCH_BS ioengine=$DM_BENCH_IOENGINE queue_depth=$DM_BENCH_QD jobs=$DM_BENCH_JOBS"
            if [ -r /proc/dm-performance-stats ]; then
                echo "[dm-bench] STATS_BEFORE label=$LABEL run=$RUN $(cat /proc/dm-performance-stats)"
            fi
            /benchmark/bin/fio --name="${LABEL}-${RUN}" --filename="$DEVICE" \
                --rw="$DM_BENCH_RW" --bs="$DM_BENCH_BS" --ioengine="$DM_BENCH_IOENGINE" \
                --direct=1 --iodepth="$DM_BENCH_QD" \
                --size="$DM_BENCH_SIZE" --time_based=1 \
                --ramp_time="$DM_BENCH_RAMP" --runtime="$DM_BENCH_RUNTIME" \
                --numjobs="$DM_BENCH_JOBS" --group_reporting=1 --percentile_list=50:95:99:99.9 \
                --output-format=json
            if [ "$DM_BENCH_LABEL" = "dm-verity" ] && [ -r /proc/dm-verity-stats ]; then
                echo "[dm-bench] STATS label=$LABEL run=$RUN $(cat /proc/dm-verity-stats) perf=$(cat /proc/dm-performance-stats 2>/dev/null || echo unavailable)"
            else
                echo "[dm-bench] STATS label=$LABEL run=$RUN backend=$(cat /proc/dm-crypto-backend 2>/dev/null || echo unavailable) perf=$(cat /proc/dm-performance-stats 2>/dev/null || echo unavailable)"
            fi
            echo "[dm-bench] END label=$LABEL run=$RUN"
        done
        RUN=$((RUN + 1))
    done
    echo "[dm-bench] PASS ${DM_BENCH_RUNS}-run raw/$DM_BENCH_LABEL matrix completed"
    poweroff -f
    exit 0
fi

if [ -n "$VERITY_PROBE_DEVICE" ]; then
    echo "[verity-probe] commit=9d79542cadddc6164ad3f31fd8cba776969d85a9 block=$VERITY_PROBE_BLOCK cmdline=$(cat /proc/cmdline)"
    if [ ! -b "$VERITY_PROBE_DEVICE" ]; then
        echo "[verity-probe] PASS integrity rejected before mapper publication status=$(cat /proc/dm-verity-stats 2>/dev/null || echo unavailable)"
        poweroff -f
        exit 0
    fi
    if dd if="$VERITY_PROBE_DEVICE" of=/tmp/verity-probe bs=4096 skip="$VERITY_PROBE_BLOCK" count=1 2>/tmp/verity-probe.err; then
        echo "[verity-probe] FAIL corrupted block delivered as successful data hash=$(sha256sum /tmp/verity-probe | cut -d' ' -f1)"
        poweroff -f
    fi
    echo "[verity-probe] PASS mapper read returned IoError/integrity rejection block=$VERITY_PROBE_BLOCK error=$(cat /tmp/verity-probe.err) status=$(cat /proc/dm-verity-stats 2>/dev/null || echo unavailable)"
    poweroff -f
    exit 0
fi

if [ -n "$CRYPT_CORRECTNESS_DEVICE" ]; then
    echo "[crypt-correctness] commit=9d79542cadddc6164ad3f31fd8cba776969d85a9"
    echo "[crypt-correctness] cmdline=$(cat /proc/cmdline)"
    dd if=/dev/zero of=/tmp/key.correct bs=64 count=1 2>/dev/null
    dd if=/dev/zero bs=63 count=1 2>/dev/null | tr '\000' '\377' > /tmp/key.wrong
    printf '\377' >> /tmp/key.wrong
    cryptsetup open --type plain --cipher aes-xts-plain64 --key-size 512 \
        --key-file /tmp/key.correct "$CRYPT_CORRECTNESS_DEVICE" correctness
    CASE=3
    for SIZE in 4096 32768 262144; do
        dd if=/dev/urandom of=/tmp/input bs="$SIZE" count=1 2>/dev/null
        dd if=/tmp/input of=/dev/mapper/correctness bs="$SIZE" count=1 conv=fsync 2>/dev/null
        dd if=/dev/mapper/correctness of=/tmp/output bs="$SIZE" count=1 2>/dev/null
        WRITE_HASH=$(sha256sum /tmp/input | cut -d' ' -f1)
        READ_HASH=$(sha256sum /tmp/output | cut -d' ' -f1)
        echo "[crypt-correctness] C0$CASE size=$SIZE write_hash=$WRITE_HASH read_hash=$READ_HASH"
        if [ "$WRITE_HASH" != "$READ_HASH" ] || ! cmp -s /tmp/input /tmp/output; then
            echo "[crypt-correctness] FAIL C0$CASE mapper round-trip"
            poweroff -f
        fi
        echo "[crypt-correctness] PASS C0$CASE mapper round-trip"
        if [ "$CASE" = "3" ]; then
            C01_HASH=$WRITE_HASH
            echo "[crypt-correctness] PASS C01 correct-key mapper write/read hash=$C01_HASH"
        fi
        CASE=$((CASE + 1))
    done
    cryptsetup close correctness
    cryptsetup open --type plain --cipher aes-xts-plain64 --key-size 512 \
        --key-file /tmp/key.wrong "$CRYPT_CORRECTNESS_DEVICE" wrong-key
    dd if=/dev/mapper/wrong-key of=/tmp/wrong-output bs=4096 count=1 2>/dev/null
    WRONG_HASH=$(sha256sum /tmp/wrong-output | cut -d' ' -f1)
    echo "[crypt-correctness] C02 correct_hash=$C01_HASH wrong_key_hash=$WRONG_HASH"
    if [ "$WRONG_HASH" = "$C01_HASH" ]; then
        echo "[crypt-correctness] FAIL C02 wrong key exposed correct plaintext"
        poweroff -f
    fi
    echo "[crypt-correctness] PASS C02 wrong key did not expose correct plaintext"
    cryptsetup close wrong-key
    poweroff -f
    exit 0
fi

if [ -n "$CRYPTSETUP_SMOKE_DEVICE" ]; then
    if [ -c /dev/mapper/control ]; then
        echo "[cryptsetup-test] control node ready: /dev/mapper/control"
    else
        echo "[cryptsetup-test] FAIL control node missing: /dev/mapper/control"
        ls -l /dev /dev/mapper 2>/dev/null
        poweroff -f
    fi
    echo "[cryptsetup-test] opening Linux plain dm-crypt table on $CRYPTSETUP_SMOKE_DEVICE"
    dd if=/dev/zero of=/tmp/cryptsetup.key bs=64 count=1 2>/dev/null
    if cryptsetup open --type plain --cipher aes-xts-plain64 --key-size 512 \
        --key-file /tmp/cryptsetup.key "$CRYPTSETUP_SMOKE_DEVICE" cryptsetup-smoke; then
        if [ -b /dev/mapper/cryptsetup-smoke ] && \
            dd if=/dev/mapper/cryptsetup-smoke of=/dev/null bs=4096 count=1 2>/dev/null; then
            echo "[cryptsetup-test] PASS real cryptsetup open created a readable mapper"
        else
            echo "[cryptsetup-test] FAIL mapper node or mapped read"
            poweroff -f
        fi
        if cryptsetup close cryptsetup-smoke 2>/tmp/cryptsetup-close.err; then
            echo "[cryptsetup-test] PASS real cryptsetup close removed the mapper"
            poweroff -f
            exit 0
        else
            echo "[cryptsetup-test] FAIL real cryptsetup close"
            poweroff -f
        fi
    else
        echo "[cryptsetup-test] FAIL real cryptsetup open"
        poweroff -f
    fi
fi

# The dm-root mode performs a real root transition instead of merely mounting
# the mapper as a side volume.  The protected image keeps /etc and application
# data, while symlinks prepared by the image builder expose the initramfs tools
# below /.initramfs so this deliberately small test root remains bootable.
if [ -n "$DM_ROOT_DEVICE" ]; then
    # Asterinas intentionally rejects pivot_root when the current root is the
    # special rootfs mount.  Re-enter init through a bind-mounted bootstrap
    # root first; its mount has a parent in the namespace, satisfying the same
    # invariant exercised by Asterinas's pivot_root regression test.
    if [ "$DM_ROOT_BOOTSTRAPPED" -eq 0 ]; then
        echo "[dm-root] entering bind-mounted bootstrap root"
        mkdir -p /bootstrap-root
        if ! mount --bind / /bootstrap-root; then
            echo "[dm-root] FAIL bootstrap root bind mount rejected"
            poweroff -f
        fi
        # A plain bind does not recursively carry the devfs submount.  The
        # second-stage init needs the already registered mapper block node.
        if ! mount --bind /dev /bootstrap-root/dev; then
            echo "[dm-root] FAIL bootstrap devfs bind mount rejected"
            poweroff -f
        fi
        exec chroot /bootstrap-root /init dm-root-stage2 "$DM_ROOT_DEVICE" "$@"
        echo "[dm-root] FAIL bootstrap chroot returned"
        poweroff -f
    fi
    if [ "$DM_ROOT_BOOTSTRAPPED" -eq 1 ] && \
        [ "${DM_ROOT_DEVICE#*crypt}" != "$DM_ROOT_DEVICE" ] && \
        [ -r /proc/dm-crypto-backend ]; then
        echo "[dm-perf] AES backend=$(cat /proc/dm-crypto-backend)"
    fi
    if [ "$DM_ROOT_BOOTSTRAPPED" -eq 1 ] && \
        [ "${DM_ROOT_DEVICE#*verity}" != "$DM_ROOT_DEVICE" ] && \
        [ -r /proc/dm-verity-stats ]; then
        echo "[dm-perf] verity $(cat /proc/dm-verity-stats)"
    fi
    echo "[dm-root] mounting protected root from $DM_ROOT_DEVICE"
    if [ ! -b "$DM_ROOT_DEVICE" ]; then
        if [ -r /proc/dm-verity-stats ]; then
            echo "[dm-root] FAIL mapper device is missing: $DM_ROOT_DEVICE ($(cat /proc/dm-verity-stats))"
        else
            echo "[dm-root] FAIL mapper device is missing: $DM_ROOT_DEVICE"
        fi
        poweroff -f
    fi
    mkdir -p /newroot
    if ! mount -t ext2 -o ro "$DM_ROOT_DEVICE" /newroot; then
        echo "[dm-root] FAIL protected root mount rejected"
        poweroff -f
    fi
    if [ ! -f /newroot/etc/dm-verity-proof ]; then
        echo "[dm-root] FAIL proof file is missing before root switch"
        poweroff -f
    fi
    mkdir -p /newroot/.initramfs
    if ! pivot_root /newroot /newroot/.initramfs; then
        echo "[dm-root] FAIL pivot_root rejected"
        poweroff -f
    fi
    cd /
    if [ -f /etc/dm-verity-proof ] && [ -d /.initramfs ]; then
        echo "[dm-root] PASS system root switched to protected mapper"
        if [ -x /.initramfs/bin/busybox ]; then
            echo "[dm-root] PASS initramfs runtime retained below /.initramfs"
            exec /.initramfs/bin/busybox poweroff -f
        fi
        echo "[dm-root] FAIL initramfs runtime is unavailable after pivot_root"
    else
        echo "[dm-root] FAIL protected root is not active"
        /.initramfs/bin/poweroff -f
    fi
fi

# The optional third disk is used by tools/run_dm_verity.sh.  Treat the
# mapper—not the raw disk—as the proof surface so a successful test exercises
# registration, on-disk hash verification and filesystem I/O together.
if [ -z "$DM_ROOT_DEVICE" ] && [ -b /dev/vdc ]; then
    echo "[dm-test] lower device detected: /dev/vdc"
    if [ -b /dev/dm-verity0 ]; then
        DM_MAPPER=/dev/dm-verity0
    elif [ -b /dev/dm-crypt0 ]; then
        DM_MAPPER=/dev/dm-crypt0
    else
        DM_MAPPER=
    fi
    if [ -z "$DM_MAPPER" ]; then
        echo "[dm-test] FAIL mapper device is missing"
    else
        mkdir -p /dm-verity
        if mount -t ext2 -o ro "$DM_MAPPER" /dm-verity; then
            if [ -f /dm-verity/etc/dm-verity-proof ]; then
                echo "[dm-test] proof: $(cat /dm-verity/etc/dm-verity-proof)"
                echo "[dm-test] PASS protected ext2 mounted through $DM_MAPPER"
            else
                echo "[dm-test] FAIL proof file is missing"
            fi
            umount /dm-verity
        else
            echo "[dm-test] FAIL protected ext2 mount rejected"
        fi
    fi
fi

# When the init process starts,
# it does not have a process group, session, or controlling terminal.
# The `script` tool is a standard Linux utility
# that captures everything displayed on your terminal screen and records it to a file.
# It tricks a program into thinking it is running in an interactive terminal.
#
# TODO: Use `cttyhack` once we support it, which is a better choice.
script /dev/null -q -c "$*"

poweroff -f
